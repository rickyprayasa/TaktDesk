<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ cloud backup and phone-to-phone transfer. The focus history, slips and settings (the drift database in
  app_flutter/) move to the new phone; state that only means something on this phone stays behind:
  - takt_widget_prefs: running countdown deadlines (elapsedRealtime of this boot) and widget snapshots;
  - zykl_lockdown: whether lockdown turned DND on here, and the filter to put back;
  - zykl_permissions: "notification permission already asked" (the new phone must ask again);
  - zykl_shortcuts: what was published to this launcher.
  Keep in sync with backup_rules.xml (Android 11 and older).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="takt_widget_prefs.xml" />
        <exclude domain="sharedpref" path="zykl_lockdown.xml" />
        <exclude domain="sharedpref" path="zykl_permissions.xml" />
        <exclude domain="sharedpref" path="zykl_shortcuts.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="takt_widget_prefs.xml" />
        <exclude domain="sharedpref" path="zykl_lockdown.xml" />
        <exclude domain="sharedpref" path="zykl_permissions.xml" />
        <exclude domain="sharedpref" path="zykl_shortcuts.xml" />
    </device-transfer>
</data-extraction-rules>
