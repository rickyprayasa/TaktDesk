<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_chassis_bg"
    android:gravity="center"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_dial_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_dial_standby_face"
        android:contentDescription="AW10 Analog Dial Face" />

    <TextView
        android:id="@+id/widget_time_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="4dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.06"
        android:text="STANDBY"
        android:textColor="#F2EFE9"
        android:textSize="10sp"
        android:textStyle="bold" />

</RelativeLayout>
